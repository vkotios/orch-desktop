# Dependencies & Build Outputs
node_modules/
dist/
target/

# Runtime state written by orch (never source)
orch/.state/
orch/.state-test/
orch/.lane/
.reviews/

# Per-user configuration (copy the *.example.json files)
orch.config.json
orch/roster.json

# Logs and run output
*.log
bench-results*.json

# Tauri generated schemas (build output)
apps/desktop/src-tauri/gen/schemas/

# Generated Windows runtime staging (prepare-runtime.mjs output; never commit binaries)
apps/desktop/src-tauri/.runtime/

# Host-built coordinator macOS process helper
orch/native/darwin-processes
orch/native/darwin-processes.[0-9]*
